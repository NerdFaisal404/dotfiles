# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

# Use Powerlevel10k theme for better performance and aesthetics.
ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_DISABLE_COMPFIX="true"

# Enable Powerlevel10k instant prompt (must be at the top).
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Terminal configuration
export TERM="xterm-256color"

# Enable case-sensitive completion.
# CASE_SENSITIVE="true"

# Plugins (remove duplicates)
plugins=(git z)

# Aliases
alias reload-zsh="source ~/.zshrc"
alias edit-zsh="nvim ~/.zshrc"
alias fbr="flutter pub run build_runner build --delete-conflicting-outputs"
alias fbw="flutter pub run build_runner watch --delete-conflicting-outputs"
alias fpg="flutter pub get"
alias kill_all="killall -9 dart"
alias ls="eza --icons=always"

# History configuration
HISTFILE="$HOME/.zhistory"
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# Arrow key history search
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Source plugins
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# NVM setup
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# Android SDK configuration
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/platform-tools"

# Java and Flutter setup
export JAVA_HOME="/Library/Java/JavaVirtualMachines/corretto-11.0.21/Contents/Home"
export PATH="$JAVA_HOME/bin:/opt/homebrew/bin:$HOME/Desktop/dev/flutter/bin:$PATH"

# FZF setup
eval "$(fzf --zsh)"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
source "$HOME/fzf-git.sh/fzf-git.sh"  # Ensure this file exists or remove if not necessary

# Eza file preview
show_file_or_dir_preview="if [ -d {} ]; then eza --tree --color=always {} | head -200; else bat -n --color=always --line-range :500 {}; fi"
export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

# iTerm2 integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
