{
  "version": 3,
  "lines": [
    [
      { "id": "l1-model", "type": "model", "rawValue": true },
      { "id": "l1-branch", "type": "git-branch" },
      { "id": "l1-changes", "type": "git-changes" },
      { "id": "l1-ctx", "type": "context-percentage", "rawValue": true },
      { "id": "l1-cost", "type": "session-cost", "rawValue": true }
    ],
    [
      { "id": "l2-session", "type": "session-usage", "metadata": { "display": "slider" } },
      { "id": "l2-weekly", "type": "weekly-usage", "metadata": { "display": "slider" } },
      { "id": "l2-reset", "type": "reset-timer" },
      { "id": "l2-weekly-reset", "type": "weekly-reset-timer" }
    ],
    []
  ],
  "flexMode": "full-minus-40",
  "compactThreshold": 60,
  "colorLevel": 3,
  "defaultPadding": " ",
  "inheritSeparatorColors": false,
  "globalBold": false,
  "gitCacheTtlSeconds": 5,
  "minimalistMode": false,
  "powerline": {
    "enabled": true,
    "separators": [""],
    "separatorInvertBackground": [false],
    "startCaps": [],
    "endCaps": [""],
    "autoAlign": false,
    "continueThemeAcrossLines": false,
    "theme": "tokyonight"
  }
}
